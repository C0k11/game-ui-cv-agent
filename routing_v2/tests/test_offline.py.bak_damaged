                B(V.AP, cx=0.40, cy=0.033), B(V.CREDIT, cx=0.51, cy=0.033),
                B(V.PYROXENE, cx=0.67, cy=0.053))
    _ok = _tb2(B(V.CONFIRM, cx=0.6, cy=0.7), "娓告垙鍐呯‘璁?)
    check("娓告垙鍐呯‘璁ゆ锛堥《鏍忓湪锛夌収甯告斁琛?, _g.money(_ok, _ingame).ok)

    # 娓告垙鍐呯殑纭妗嗭紙椤舵爮璐у竵鍦級涓嶈琚綋鎴愮郴缁熼€€鍑烘
    ingame = O(B(V.CONFIRM, cx=0.6, cy=0.7), B(V.CANCEL, cx=0.4, cy=0.7),
               B(V.AP, cx=0.40, cy=0.033), B(V.CREDIT, cx=0.51, cy=0.033),
               B(V.PYROXENE, cx=0.67, cy=0.053))
    check("娓告垙鍐呯‘璁ゆ锛堥《鏍忓湪锛変笉璇垽鎴愮郴缁熼€€鍑烘",
          classify(ingame).interrupt != "quit_dialog",
          f"瀹為檯 {classify(ingame).interrupt}")

    # 涓婃湡娲诲姩
    check("寰屾棩璜?鈫?event_ended",
          classify(O(B(V.EVENT_AFTERSTORY), B(V.EVENT_SHOP))).page == "event_ended")


# 鈺愨晲 2. 杩炵画 N 甯х‘璁?鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?def t_machine():
    print("\n鈹€鈹€ 搂A3 杩炵画甯х‘璁?鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€")
    m = Machine(confirm_frames=3)
    lobby = O(B(V.NAV_CAFE), B(V.NAV_SHOP), B(V.NAV_CRAFT))
    for _ in range(3):
        st = m.update(lobby)
    check("3 甯у悗纭澶у巺", st.page == "lobby")

    # 涓€甯ц浆鍦哄櫔澹颁笉璇ョ炕椤?    noise = O(B(V.SORTIE))
    st = m.update(noise)
    check("鍗曞抚杞満鍣０涓嶇炕椤?, st.page == "lobby", f"raw={st.raw}")
    st = m.update(lobby)
    st = m.update(lobby)
    check("鍣０鍚庝粛鏄ぇ鍘?, st.page == "lobby")

    # 鐪熺殑鎹㈤〉瑕?3 甯?    form = O(B(V.SORTIE), B(V.SQUAD_1_HI))
    st = m.update(form)
    check("鎹㈤〉绗?1 甯т笉璁?, st.page == "lobby")
    st = m.update(form)
    st = m.update(form)
    check("鎹㈤〉绗?3 甯ф墠璁?, st.page == "formation", f"瀹為檯 {st.page}")

    # 鉀攂lank 鍏滃簳鍙厑璁?涓婁竴涓寰楀嚭鐨勯〉闈㈡槸澶у巺"鏃跺紑鐏紙鎴樻枟涓緢澶氬抚闆舵鍑猴紝
    #    鍦ㄩ偅閲岀偣灞忓箷涓ぎ鍙兘瑙﹀彂瀛︾敓鎶€鑳?鈥斺€?08-08 live 瀹為敜锛?    from routing_v2.flow import nav
    m2 = Machine(1)
    blank = O()
    for _ in range(3):
        stb = m2.update(blank)
    check("blank 涓斿垰璧疯繘绋?last_solid=unknown) 鈫?鍏佽鍞ゅ洖锛屽埆鍗℃",
          nav.blank_escape(stb, 0) is not None, f"last_solid={stb.last_solid}")
    m2b = Machine(1)
    battle = O(B(V.BATTLE_PAUSE), B(V.BATTLE_3X))
    m2b.update(battle)
    for _ in range(60):
        stb2 = m2b.update(blank)
    check("鉀攂lank 浣嗕笂涓€椤垫槸鎴樻枟 鈫?**涓嶇偣**锛堝彲鑳借Е鍙戝鐢熸妧鑳斤級",
          nav.blank_escape(stb2, 0) is None, f"last_solid={stb2.last_solid}")
    m3 = Machine(1)
    m3.update(lobby)
    for _ in range(60):
        stb = m3.update(blank)
    check("blank 涓斾笂涓€椤垫槸澶у巺 鈫?鐐逛腑澶敜鍥?,
          nav.blank_escape(stb, 45) is not None, f"last_solid={stb.last_solid}")


# 鈺愨晲 3. 涓夐亾闂?鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲
def t_gate():
    print("\n鈹€鈹€ 涓夐亾闂?鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€")
    g = Gate(cfg(), log=lambda m: None)

    # 鈶?閲戦挶
    body = O(B(V.PYROXENE, cx=0.5, cy=0.55))
    act = Action(kind="tap", x=0.5, y=0.7, reason="闅忎究鐐?, target_cls="x")
    v = g.money(act, body)
    check("鉀斿脊绐椾綋鍐呴潚杈夌煶 鈫?鎷︿笅涓?halt", (not v.ok) and v.halt)
    # 猸愪絾**瀵艰埅鐧藉悕鍗?*閲岀殑 cls 瑕佹斁琛?鈥斺€?鍚﹀垯璐拱椤典細琚嫤姝伙紝
    #   鍏嶈不绲勫悎鍖呮案杩滆蛋涓嶅畬锛?8-09 瀹為敜锛氳繛"鍒囧埌绲勫悎鍖?tab"閮借 halt锛夈€?    #   鉀旀槸鐧藉悕鍗曚笉鏄粦鍚嶅崟锛氭紡涓€涓姳閽辨寜閽?鐪熻姳閽憋紝婕忎竴涓鑸寜閽?鍙槸鍗′綇銆?    _navs = [V.COMBO_PACK, V.CLOSE_X, V.BACK, V.CANCEL]
    for _n in _navs:
        _va = g.money(Action(kind="tap", x=0.7, y=0.25, reason="鍒噒ab/閫€鍑?,
                             target_cls=_n), body)
        check(f"璐拱椤典笂鐐瑰鑸?`{_n}` 鈫?鏀捐锛堜笉鑺遍挶锛?, _va.ok, _va.why)
    _vb = g.money(Action(kind="tap", x=0.3, y=0.7, reason="鐐硅臣璨?,
                         target_cls=V.SHOP_BUY), body)
    check("鉀旇喘涔伴〉涓婄偣 `璐拱` 鈫?浠嶆嫤鎴愪汉瀹?, not _vb.ok, _vb.why)

    v = g.money(Action(kind="tap", x=0.5, y=0.5, reason="涔?, money=True,
                       spend="闈掕緣鐭?), O(B(V.NAV_CAFE)))
    check("鉀斿０鏄庤姳闈掕緣鐭?鈫?鐩存帴鎷?, not v.ok)

    # 鉀斺洈璐拱纭妗嗙洸鍖猴紙08-10 live 鎶撳埌锛屽洓鍚戦攣锛?    #   銆屾槸鍚﹁臣璨疯鍟嗗搧锛熴€嶈繖涓€甯? 椤舵爮浠ヤ笅娌℃湁闈掕緣鐭筹紙浠风鏄?CAD/鍏嶈不锛夈€?    #   tab 琚鐩栦綇銆佷篃娌℃湁姝ヨ繘鍣?鈬?money.purchase_context() **鍥涙潯鍒ゆ嵁鍏?None**锛?    #   闂稿杩欎竴甯у師鏈畬鍏ㄦ槸鐬庣殑銆傜湡閽卞寘鐨勭‘璁ゆ鍜屽厤璨诲寘**闀垮緱涓€妯′竴鏍?*銆?    _dlg = O(B(V.CONFIRM, cx=0.60, cy=0.83), B(V.CANCEL, cx=0.40, cy=0.83),
             B(V.CREDIT, cx=0.51, cy=0.05))          # 椤舵爮璐у竵鍦紝寮圭獥浣撳唴娌￠潚杈夌煶
    check("鈶?杩欎竴甯?purchase_context 纭疄鏄?None锛堢洸鍖烘垚绔嬶級",
          money_rules.purchase_context(_dlg) is None)
    # 鈿燻_last` 鍙湪 dedup() 閲岃惤 鈥斺€?鐢ㄥ畠妯℃嫙"涓婁竴鍙戠湡鐨勫彂鍑哄幓浜?
    _prev = lambda g, c: g.dedup(Action(kind="tap", x=0.3, y=0.7, reason="涓婁竴鍙?,
                                        target_cls=c), False, 0, 25)
    g4 = Gate(cfg(), log=lambda m: None)
    _prev(g4, V.SHOP_BUY)
    _vc = g4.money(Action(kind="tap", x=0.60, y=0.83, reason="纭",
                          target_cls=V.CONFIRM), _dlg)
    check("鈶?涓婁竴鍙戞槸 `璐拱` + 鍙岄敭妗?+ 娌″啓銆屽厤璨汇€嶁啋 鎷︽垚浜哄",
          (not _vc.ok) and _vc.needs_human, _vc.why)
    g5 = Gate(cfg(), log=lambda m: None)
    _prev(g5, V.SHOP_BUY)
    _free = O(B(V.CONFIRM, cx=0.60, cy=0.83), B(V.CANCEL, cx=0.40, cy=0.83),
              B(V.CREDIT, cx=0.51, cy=0.05), B(V.FREE, cx=0.66, cy=0.62))
    _vd = g5.money(Action(kind="tap", x=0.60, y=0.83, reason="纭",
                          target_cls=V.CONFIRM), _free)
    check("鈶?鍚屼竴涓鍐欑潃銆屽厤璨汇€嶁啋 鏀捐锛堝厤璨荤祫鍚堝寘閭ｆ潯閾句笉鑳借鎷︽锛?,
          _vd.ok, _vd.why)
    g6 = Gate(cfg(), log=lambda m: None)
    _prev(g6, V.SWEEP_START)
    _ve = g6.money(Action(kind="tap", x=0.60, y=0.83, reason="纭",
                          target_cls=V.CONFIRM), _dlg)
    check("鈶?涓婁竴鍙戞槸銆屾巸钑枊濮嬨€?涓嶈姳閽辩殑閿? 鈫?涓嶈鎷?,
          _ve.ok, _ve.why)

    # 鈶?JIT 钀藉湴澶嶉獙
    from routing_v2.act.action import tap_box
    g2 = Gate(cfg(), log=lambda m: None)
    tgt = B(V.EVENT_LIVE, cx=0.5, cy=0.20)
    a = tap_box(tgt, "杩涙椿鍔?, dy=0.075)          # 猸愯惤鐐规晠鎰忓湪妗嗗
    check("HUB 钀界偣纭疄鍦ㄩ敋鐐规澶?, not tgt.contains(a.x, a.y),
          f"tap y={a.y:.3f} 妗?y2={tgt.y2:.3f}")
    old = O(tgt, seq=1)
    gone = O(B(V.EVENT_ENDED, cx=0.5, cy=0.20), seq=2)      # 杞挱缈婚〉浜?    v = g2.jit(a, old, lambda: gone)
    check("搂A7 杞挱缈婚〉 鈫?JIT 涓㈠純杩欎竴鍙?, not v.ok, v.why)

    moved = O(B(V.EVENT_LIVE, cx=0.5, cy=0.60), seq=3)      # 鍚屽悕浣嗕綅缃彉浜?    v = g2.jit(a, old, lambda: moved)
    check("銆岄檮杩戞湁鍚屽悕銆嶁墵銆岃繕鏄偅涓€涓€嶁啋 涔熶涪寮?, not v.ok, v.why)

    same = O(B(V.EVENT_LIVE, cx=0.5, cy=0.20), seq=4)
    v = g2.jit(a, old, lambda: same)
    check("閿氱偣娌″姩 鈫?鏀捐锛堝摢鎬曡惤鐐瑰湪妗嗗锛?, v.ok, v.why)

    # 鈶?杩炲彂
    g3 = Gate(cfg(), log=lambda m: None)
    a2 = Action(kind="tap", x=0.3, y=0.3, reason="r", target_cls="btn")
    check("绗竴鍙戞斁琛?, g3.dedup(a2, False, 0, 25).ok)
    check("鍚岃惤鐐归〉闈㈡病鍙?鈫?鍚炴帀", not g3.dedup(a2, False, 1, 25).ok)
    check("寰呭 retry_frames 鈫?琛ヤ竴鍙?, g3.dedup(a2, False, 25, 25).ok)
    # 鉀斿埆鎷?reason 鎺緸褰撴帶鍒?API锛氭崲涓枃妗堜笉璇ョ粫杩囬椄
    a3 = Action(kind="tap", x=0.3, y=0.3, reason="纰鸿獚閿?!", target_cls="btn")
    check("鉀旀崲 reason 鏂囨缁曚笉杩囪繛鍙戦椄", not g3.dedup(a3, False, 2, 25).ok)


# 鈺愨晲 4. flow 璺?tick 鐘舵€侊紙鐪熷疄渚嬶紝涓嶆槸 stateless 鍥炴斁锛夆晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?def t_flows():
    print("\n鈹€鈹€ flow 璺?tick 琛屼负 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€")
    c = cfg()
    ctx = Ctx(cfg=c, log=lambda m: None)

    # craft: 猸愮伆鎬?cls 浼樺厛锛埪6 鈥斺€?妯″瀷淇ソ涓嶈兘鎶婂厹搴曟墦姝伙級
    craft = ALL["craft"](ctx)
    m = Machine(1)
    grey = O(B(V.CRAFT_START_GREY, conf=0.99, cx=0.8, cy=0.85))
    st = m.update(grey)
