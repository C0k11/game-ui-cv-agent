    # 鍏抽敭瀹炵幇绾︽潫锛氱敤**绁ㄦ暟宸?*绠楀凡鐢ㄥ嚑寮狅紝涓嶇敤璁℃暟鍣紙鏁颁簨瀹炰笉鏁版剰鍥撅級銆?    def _bounty_with(plan, tix, branch, tix0):
        f = ALL["bounty"](ctx)
        f.cfg = dict(f.cfg or {})
        f.cfg["ticket_plan"] = plan
        f.setup()
        f.state.update(branch_name=branch, branch_tix0=tix0, tickets0=6)
        m = Machine(1)
        ob = O(B(V.TICKET_BOUNTY, cx=0.2, cy=0.05),
               B(V.STAGE_ENTER, cx=0.75, cy=0.40),
               B(V.STAGE_ENTER, cx=0.75, cy=0.60))
        return f, ob, m.update(ob)

    f, ob, _ = _bounty_with({"鏁欏": 3}, 6, "鏁欏", 6)
    check("绁ㄩ厤棰? 鍒嗘敮鍚?鍩虹嚎閮藉湪锛岄厤棰濇湭鐢ㄥ畬 鈫?_quota 璁ゅ緱鍑?,
          f._quota("鏁欏") == 3 and f._quota("娌欐紶閾侀亾") is None)
    check("绁ㄩ厤棰? 娌￠厤鐨勫垎鏀笉闄愭祦", f._quota("楂樻灦鍏矾") is None)

    f2, _, _ = _bounty_with({}, 6, "鏁欏", 6)
    check("猸愮暀绌?ticket_plan = 鑰佽涓猴紙涓嶉檺娴侊級",
          f2._plan() == {} and f2._quota("鏁欏") is None)

    # 鉀旀崲鍒嗘敮蹇呴』娓?branch_tix0 鈥斺€?涓嶆竻鐨勮瘽涓嬩竴涓垎鏀嬁涓婁竴涓殑鍩虹嚎锛?    #   閰嶉浼氱灛闂?鐢ㄥ畬"锛岀浜屼釜鍒嗘敮涓€寮犵エ閮戒笉鎵撱€?    f3, _, _ = _bounty_with({"鏁欏": 3, "楂樻灦鍏矾": 3}, 6, "鏁欏", 6)
    f3.state["tickets"] = 3
    f3._next_branch_or_done("閰嶉鐢ㄥ畬")
    check("鉀旀崲鍒嗘敮娓呮帀 branch_tix0锛堝惁鍒欎笅涓垎鏀厤棰濈灛闂?鐢ㄥ畬'锛?,
          f3.state["branch_tix0"] is None and f3.state["branch_name"] == "")

    # 鉀斿彧閰?ticket_plan 涓嶉厤 branches 鏃讹紝鍒嗘敮鏁拌鎸?plan 鐨?key 绠楋紝
    #   鍚﹀垯 max(1, len([])) = 1 鈫?鎵撳畬绗竴涓氨鏀跺伐銆?    f4, _, _ = _bounty_with({"鏁欏": 3, "楂樻灦鍏矾": 3}, 6, "鏁欏", 6)
    f4.cfg["branches"] = []
    f4.state["branch_i"] = 0
    f4.state["tickets"] = 3
    r = f4._next_branch_or_done("閰嶉鐢ㄥ畬")
    check("鉀斿彧閰?plan 涓嶉厤 branches 鈫?浠嶄細鍘绘墦绗簩涓垎鏀?,
          f4.state["branch_i"] == 1 and not getattr(r, "is_finish", False),
          f"branch_i={f4.state['branch_i']} r={r}")

    # 猸愨瓙鏍稿績璺緞锛氱エ 6鈫? 鐢ㄦ帀 3 寮?= 閰嶉婊?鈫?鎹㈠垎鏀€?    #   绁ㄦ暟璧?OCR锛岀绾挎祴涓嶄簡 鈬?鎵撴々 `_tickets`銆傛墦妗殑鏄?*璇绘暟**锛?    #   琚祴鐨勬槸**閰嶉鍒ゅ畾閫昏緫**锛屼笉鏄嚜宸辨祴鑷繁銆?    def _quota_hit(plan, tix_now, tix0, branch="鏁欏", bi=0):
        f = ALL["bounty"](ctx)
        f.cfg = dict(f.cfg or {})
        f.cfg.update(ticket_plan=plan, branches=["鏁欏", "楂樻灦鍏矾"])
        f.setup()
        f.state.update(branch_name=branch, branch_tix0=tix0,
                       tickets0=tix0, branch_i=bi)
        f._tickets = lambda _obs: tix_now
        ob = O(B(V.TICKET_BOUNTY, cx=0.2, cy=0.05),
               B(V.STAGE_ENTER, cx=0.75, cy=0.40))
        return f, f._on_stage_list(ob, Machine(1).update(ob))

    f5, r5 = _quota_hit({"鏁欏": 3}, 3, 6)
    check("猸愮エ 6鈫? = 鐢ㄦ弧閰嶉 3 鈫?鎹㈠垎鏀紙涓嶆槸缁х画鎵擄級",
          f5.state["branch_i"] == 1, f"branch_i={f5.state['branch_i']} r={r5}")

    f6, r6 = _quota_hit({"鏁欏": 3}, 5, 6)
    check("猸愮エ 6鈫? = 鎵嶇敤 1 寮狅紝閰嶉娌℃弧 鈫?涓嶆崲鍒嗘敮",
          f6.state["branch_i"] == 0, f"branch_i={f6.state['branch_i']} r={r6}")

    # 鉀旂エ鏁拌涓嶅嚭蹇呴』 fail-closed锛堥噾閽遍搧寰?#3锛氳涓嶅嚭涓嶅嚭鍑伙級
    f7 = ALL["bounty"](ctx)
    f7.cfg = dict(f7.cfg or {})
    f7.cfg.update(ticket_plan={"鏁欏": 3}, branches=["鏁欏"])
    f7.setup()
    f7.state.update(branch_name="鏁欏", branch_tix0=6, branch_i=0)
    f7._tickets = lambda _obs: None
    _ob7 = O(B(V.TICKET_BOUNTY, cx=0.2, cy=0.05))
    # 鈿爃old() 闈?`self.ticks` 鍒?杩炵画" 鈥斺€?涓嶆帹 ticks 鐨勮瘽 cnt 姘歌繙鏄?1锛?    #   寰幆 70 娆′篃鍙細涓€鐩磋繑鍥?杩炵画纭涓?銆傜涓€鐗堝氨鏄繖涔?*鍋囬€氳繃**鐨勶細
    #   鏂锛堜笉鏄?tap锛夌宸ф垚绔嬶紝鍗存牴鏈病璧板埌琚祴鐨勯偅鏉″垎鏀€?    for _ in range(70):
        f7.ticks += 1
        r7 = f7._on_stage_list(_ob7, Machine(1).update(_ob7))
    check("鉀旂エ鏁拌涓嶅嚭 鈫?fail-closed 涓嶅嚭鍑伙紙涓旂‘瀹炶蛋鍒颁簡杩欐潯鍒嗘敮锛?,
          r7 is not None and not getattr(r7, "is_tap", False)
          and "璇讳笉鍑? in str(r7), str(r7))


