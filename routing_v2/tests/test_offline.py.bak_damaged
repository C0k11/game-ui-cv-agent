    check("D facility 搴曢〉 + 涓婁竴鍙戙€岃绋嬭〃闁嬪銆嶁啋 鏀捐锛?8-09 鍓嶄細鏃犻檺鍙栨秷涓婅锛?,
          _gq3.money(_cfm, sysq, "facility").ok)
    # C锛氬墽鎯呫€岃烦閬庛€嶇‘璁ゆ涓嶈琚?quit_dialog 鎶紙117 甯х湡瀹炲抚鏇?117/117 鍏ㄤ腑锛?    _story_dlg = O(B(V.CONFIRM, conf=0.97, cx=0.599, cy=0.725),
                   B(V.CANCEL, conf=0.98, cx=0.401, cy=0.727),
