    check("鉀斿ぇ鍘呬拱鐭冲箍鍛婁綅涓嶈鎶ワ紙live 瀹炲抚澶嶇幇锛?,
          classify(banner).interrupt is None and classify(banner).page == "lobby",
          f"瀹為檯 椤甸潰={classify(banner).page} 鎵撴柇={classify(banner).interrupt}")
    real_buy = O(B(V.SHOP_BUY_PYROXENE, conf=0.95, cx=0.5, cy=0.4),
                 B(V.CONFIRM, cx=0.6, cy=0.8), B(V.CANCEL, cx=0.4, cy=0.8))
    check("璐拱闈掕緣鐭?+ 瀵硅瘽妗嗘帶浠?鈫?鐪熺殑鍋?,
          classify(real_buy).interrupt == "money_popup")

    # 鉀?026-08-08 live 瀹為敜锛堝弽鍚戣鎶ワ級锛氭椿鍔ㄩ閫氱殑銆岀嵅寰楃崕鍕?銆嶅鍔卞崱閲?    #    灏辨湁 **闈掕紳鐭?x30**锛坈y=0.511 conf 0.94锛夆€斺€?閭ｆ槸**鏀跺叆**锛屼笉鏄环绛俱€?    #    鎵撹耽涓€鍦哄氨琚嚜宸辩殑閲戦挶闂?HALT 鎺夈€傚悓涓€涓浘鏍囷紝璇鐩稿弽銆?    reward = O(B(V.GOT_REWARD, conf=0.98, cx=0.5, cy=0.22),
               B(V.PYROXENE, conf=0.94, cx=0.669, cy=0.511))
    check("鉀斿鍔卞崱閲岀殑闈掕緣鐭?鏀跺叆锛屼笉璇姤",
          classify(reward).interrupt is None,
          f"瀹為檯 {classify(reward).interrupt}")
    real_dialog = O(B(V.PYROXENE, conf=0.94, cx=0.5, cy=0.45),
                    B(V.CONFIRM, cx=0.6, cy=0.75), B(V.CANCEL, cx=0.4, cy=0.75))
    check("鐪熻喘涔版锛堜綋鍐呴潚杈夌煶+纭/鍙栨秷锛屾棤鏀跺叆鏍囪锛夆啋 鍋?,
          classify(real_dialog).interrupt == "money_popup")

    # 鉀斺洈2026-08-08 杩為攣浜嬫晠锛氬ぇ鍘呮寜杩斿洖閿?鈫?寮广€岄洟闁嬮亰鎴层€嶇‘璁ゆ锛?    #    瀹冪殑 `纭閿甡 + 澶у巺甯搁鐨?`璩艰卜闈掕紳鐭砢 骞垮憡浣?= 璇姤璐拱娴佺鍋滄暣杞€?    quit_dlg = O(B(V.SHOP_BUY_PYROXENE, conf=0.96, cx=0.117, cy=0.360),
                 B(V.CONFIRM, cx=0.60, cy=0.70), B(V.CANCEL, cx=0.40, cy=0.70),
                 B(V.NAV_CAFE, cx=0.073, cy=0.953), B(V.NAV_SHOP, cx=0.621, cy=0.953),
                 B(V.NAV_CRAFT, cx=0.531, cy=0.953))
    check("鉀斿ぇ鍘呫€岄洟闁嬮亰鎴层€嶇‘璁ゆ涓嶈鎶ユ垚璐拱娴佺锛堣鍒?quit_dialog锛?,
          classify(quit_dlg).interrupt == "quit_dialog",
          f"瀹為檯 {classify(quit_dlg).interrupt}")
    # 涓?*澶у巺涓婄粷涓嶅彂杩斿洖閿?*锛堥偅涓瑾嶆槸閫€鍑烘父鎴忥級
    from routing_v2.flow import nav as _nv2
    from routing_v2.state.machine import Machine as _M2
    _m2 = _M2(1)
    lobby_like = O(B(V.NAV_CAFE, cx=0.073, cy=0.953), B(V.NAV_SHOP, cx=0.621, cy=0.953),
                   B(V.NAV_CRAFT, cx=0.531, cy=0.953), B(V.CLUB, cx=0.22, cy=0.46))
    for _ in range(120):
        _s2 = _m2.update(lobby_like)
    _a2 = _nv2.to_lobby(lobby_like, _s2)
    check("鉀斿ぇ鍘?澶у巺娴眰涓婁笉鍙?KEYCODE_BACK锛堜細寮归€€鍑烘父鎴忥級",
          _a2 is None or _a2.kind != "key", str(_a2))

    # 鉀斺洈绯荤粺銆屾槸鍚︾祼鏉燂紵銆嶆锛氱瑾?= 閫€鍑烘父鎴忥紝鍙鐐瑰彇娑?    sysq = O(B(V.CONFIRM, conf=0.98, cx=0.598, cy=0.699),
             B(V.CANCEL, conf=0.99, cx=0.401, cy=0.701),
             B(V.CLOSE_X, conf=0.96, cx=0.692, cy=0.230))
    check("鉀斻€屾槸鍚︾祼鏉燂紵銆嶏紙鏃犻《鏍忚揣甯侊級鈫?quit_dialog 鎵撴柇",
          classify(sysq).interrupt == "quit_dialog",
          f"瀹為檯 {classify(sysq).interrupt}")
    from routing_v2.flow.interrupt import Interrupts as _I
    _act = _I(log=lambda m: None).handle("quit_dialog", sysq)
    check("鉀斿缃彧鑳芥槸**鍙栨秷**锛屾案涓嶇偣纰鸿獚",
          _act is not None and _act.target_cls == V.CANCEL, str(_act))
    # 鉀旂浜岄亾闃茬嚎锛氶《鏍忎笉鍦ㄦ椂锛?*浠讳綍 flow 鐨?on_confirm_dialog 閮戒笉璁哥偣纰鸿獚**
    #   锛?8-08 瀹炴祴锛氬彇娑堝悗鐨勫叧闂姩鐢诲抚涓?quit_dialog 鎺変簡纭锛屽氨鏄繖閲屾浛瀹?    #     鐐逛簡纰鸿獚锛屽樊涓€鐐规妸娓告垙鍏虫帀锛?    _mf = ALL["mail"](Ctx(cfg=cfg(), log=lambda m: None))
    # 猸恌ixture 瑕佽繕鍘?*鐪熷疄鏉ヨ矾**锛氶€€鍑烘鍙粠澶у巺寮癸紙08-09 璧峰垽鎹敤 last_solid锛夈€?    #   鍏堝湪澶у巺寰呬竴甯э紝鍐嶅脊妗嗭紝杩欐牱 last_solid=lobby 鈥斺€?鍜岀湡鏈轰竴鑷淬€?    _ml = Machine(1)
    _pure_lobby = O(B(V.NAV_CAFE, cx=0.073, cy=0.953),
                    B(V.NAV_SHOP, cx=0.621, cy=0.953),
                    B(V.NAV_CRAFT, cx=0.531, cy=0.953),
                    B(V.NAV_SCHEDULE, cx=0.165, cy=0.953))
    _ml.update(_pure_lobby)
    _sv = _ml.update(sysq)
    _a3 = _mf.on_confirm_dialog(sysq, _sv)
    check("鉀旈€€鍑烘锛堜粠澶у巺寮癸級鈫?on_confirm_dialog 缁濅笉鐐圭瑾?,
          _a3 is None or _a3.target_cls == V.CANCEL, str(_a3))
    # 猸愬弽鍚戯細**娓告垙鍐?*鐨勫弻閿锛堝簳椤垫槸鍏冲崱寮圭獥锛変笉璇ヨ褰撻€€鍑烘鎷?    #   鈥斺€?銆岃浣跨敤340AP鎺冭暕17娆″棊銆嶈璇嫤杩囷紝鎵崱鐩存帴琚彇娑堬紙08-09 瀹為敜锛夈€?    _mg = Machine(1)
    _stage = O(B(V.SWEEP_START, cx=0.73, cy=0.56), B(V.TASK_START, cx=0.73, cy=0.75))
    _mg.update(_stage)
    _sv2 = _mg.update(sysq)
    _a4 = _mf.on_confirm_dialog(sysq, _sv2)
    check("鉀旀父鎴忓唴鍙岄敭妗嗭紙搴曢〉=鍏冲崱寮圭獥锛変笉褰撻€€鍑烘 鈫?鐐圭瑾?,
          _a4 is not None and _a4.target_cls == V.CONFIRM, str(_a4))
    # 鉀斺洈鉀斻€岄€€鍑烘銆嶅垽鎹殑鍥涘悜閿侊紙08-09 澶?agent 瀹℃煡 + 瀹炴祴澶嶇幇鍚庨噸鍐欙級:
    #    鍘嗗彶涓婇敊杩囦袱鐗?鈥斺€?鈶犮€岄《鏍忔病璐у竵銆嶈鎷?340AP 鎵崱妗嗭紱
    #    鈶°€宭ast_solid 涓嶅湪澶у巺绯汇€嶅湪 **Machine 鏂板缓鏃?last_solid 鎭掍负
    #      'unknown'** 鐨勭獥鍙ｉ噷 fail-OPEN锛屽疄娴?gate.ok=True 鈬?**浼氱偣纰鸿獚
    #      鍏虫帀娓告垙**锛涜€屽綋鏃剁殑娴嬭瘯**娌′紶 last_solid**锛岀粰浜嗗亣淇濊瘉銆?    #    鈬?鐜板湪鐨勫垽鎹槸銆岃繖涓鏄笉鏄垜鑷繁鐐瑰嚭鏉ョ殑銆嶏紝鍥涗釜鏂瑰悜閮借閿佹銆?    from routing_v2.act.action import tap_box as _tbq
    _cfm = _tbq(B(V.CONFIRM, cx=0.598, cy=0.699), "鐐圭瑾?)
    _gq = Gate(cfg(), log=lambda m: None)
    check("鉀斺洈A 閫€鍑烘 + 娌＄偣杩囦换浣曚細寮规鐨勯敭 + last_solid=unknown 鈫?蹇呴』鎷?,
          not _gq.money(_cfm, sysq, "unknown").ok,
          _gq.money(_cfm, sysq, "unknown").why)
    _gq2 = Gate(cfg(), log=lambda m: None)
    _gq2._last = (0.731, 0.563, V.SWEEP_START)      # 涓婁竴鍙戠偣浜嗐€屾壂鑽″紑濮嬨€?    check("B 鍚屼竴涓浣嗕笂涓€鍙戞槸銆屾壂鑽″紑濮嬨€嶁啋 鏀捐锛堜笉璁歌鏉€娓告垙鍐呮锛?,
