          classify(_story_dlg).interrupt == "story_cutscene",
          f"瀹為檯 {classify(_story_dlg).interrupt}")

    # 猸愮祫鍚堝寘椤碉細**涓嶅仠鏈?*锛坆ot 涓诲姩杩涙潵鎷垮厤璨诲寘锛夛紝浣嗚姳閽辩殑閭ｄ竴涓嬩粛瑕佽鎷︺€?    #   08-09 鍓嶆槸鏃犳潯浠?halt 鈬?榛樿閰嶇疆姣忔鑷富璺戦兘鍦?shop 鏁磋疆鍋滄満銆?    from routing_v2.flow.interrupt import Interrupts as _Iq
    _combo = O(B(V.COMBO_PACK, conf=0.98, cx=0.701, cy=0.251),
               B(V.SHOP_BUY, conf=0.98, cx=0.299, cy=0.695),
               B(V.FREE, conf=0.97, cx=0.301, cy=0.651))
    check("绲勫悎鍖呴〉 鈫?money_popup 涓?halt锛堝惁鍒欏厤璨诲寘姘歌繙鎷夸笉鍒帮級",
          _Iq(log=lambda m: None).handle("money_popup", _combo) is None)
    _gc = Gate(cfg(), log=lambda m: None)
    check("鉀斾絾绲勫悎鍖呴〉涓婄偣 `璐拱` 浠嶈鎷︽垚浜哄",
          not _gc.money(_tbq(B(V.SHOP_BUY, cx=0.299, cy=0.695), "涔?), _combo).ok)

    # 鉀斺洈鐪熸涓嶅彲缁曡繃鐨勯偅閬擄細**闂?*銆傚叓涓?flow 閮借鍐欎簡 on_confirm_dialog锛?    #    鎶ゆ爮鏀惧熀绫讳細琚暣浣撶粫杩囷紙08-08 craft 灏辫繖涔堝湪閫€鍑烘涓婄偣浜嗙瑾嶏級銆?    from routing_v2.act.action import tap_box as _tb2
    _g = Gate(cfg(), log=lambda m: None)
    _bad = _tb2(B(V.CONFIRM, cx=0.598, cy=0.699), "flow 鑷繁瑕佺偣纰鸿獚")
    check("鉀斺洈闂告嫤涓嬨€岄《鏍忓叏鏃犵殑鍙岄敭妗嗕笂鐐圭瑾嶃€嶏紙璋侀兘缁曚笉杩囷級",
          not _g.money(_bad, sysq).ok, _g.money(_bad, sysq).why)
