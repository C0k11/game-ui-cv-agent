        check("鉀斾贡鐮侀厤缃繀椤绘嫆缁濆啓鐩?, "涔辩爜" in str(e), str(e)[:60])
    try:
        _save({"bounty": {"branches": ["鏁欏", "楂樻灦鍏矾"]},
               "cafe": {"invite_targets": ["鐖变附涓?鎴樻枟)"]}}, _tmp)
        check("鉁呮甯镐腑鏂囬厤缃収甯稿啓鐩橈紙鍒浼わ級", True)
    except Exception as e:
        check("鉁呮甯镐腑鏂囬厤缃収甯稿啓鐩橈紙鍒浼わ級", False, str(e)[:80])
    finally:
        if os.path.exists(_tmp):
            os.remove(_tmp)
    check("MomoTalk 榛樿鍏?, c["modules"]["momotalk"] is False)
    check("鍥炲ぇ鍘呭厹搴曢粯璁ゅ叧", c["run"]["allow_home_escape"] is False)


# 鈺愨晲 6. 姝诲垽鎹?鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲
def t_invariants():
    """鏋舵瀯涓嶅彉閲?鈥斺€?鎵簮鐮侊紝闃?淇竴澶勬病 grep 鍏ㄤ粨鍚屽舰"銆?""
    print("\n鈹€鈹€ 鏋舵瀯涓嶅彉閲?鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€")
    import re
    root = _ROOT / "routing_v2"
    # 鉀旇繑鍥為敭**鍙兘鏈変竴涓彂璧峰**锛坣av.back_key锛夈€傚畠鏄敮涓€鎸′綇"澶у巺鎸夎繑鍥?    #    寮归€€鍑烘父鎴忔"鐨勫湴鏂癸紱2026-08-08 鎴戞妸闂稿啓浜嗕袱浠姐€佹紡浜嗙涓夊锛?    #    缁撴灉 runner 缁曡繃闂稿湪澶у巺杩炴寜 6 娆紝鎶婃父鎴忓叧鎺変簡銆?    origins = []
    for p in root.rglob("*.py"):
        if p.name in ("device.py", "action.py") or "tests" in p.parts:
            continue
        for i, line in enumerate(p.read_text(encoding="utf-8").splitlines(), 1):
            s = line.strip()
            if s.startswith("#") or '"""' in s:
                continue
            if re.search(r'keycode\s*=\s*["\']KEYCODE_BACK', s):
                origins.append(f"{p.relative_to(root)}:{i}")
    check("鉀旇繑鍥為敭鍙湁涓€涓彂璧峰锛坣av.back_key锛?, len(origins) == 1,
          str(origins))

    # 鉀擮CR 鍙兘浠?read.py 鍙戣捣锛圷OLO 涓诲銆丱CR 鍙鏁板瓧锛?    ocr = []
    for p in root.rglob("*.py"):
        if p.name == "read.py" or "tests" in p.parts:
            continue
        if "RapidOCR" in p.read_text(encoding="utf-8"):
            ocr.append(str(p.relative_to(root)))
    check("鉀擮CR 鍙湪 percept/read.py 閲屽嚭鐜帮紙涓嶈杩涘喅绛栭摼锛?, not ocr, str(ocr))

    # 鉀旂儹璺緞涓嶈 ADB 鎶撳抚
    grabs = []
    for p in root.rglob("*.py"):
        if p.name in ("device.py", "feed.py") or "tests" in p.parts:
            continue
        if "screencap" in p.read_text(encoding="utf-8"):
            grabs.append(str(p.relative_to(root)))
    check("鉀旈櫎 device/feed 澶栨病鏈変换浣曞湴鏂?ADB 鎶撳抚", not grabs, str(grabs))

    # 鉀斺洈**婊戝姩鍓嶄笉璁告敼鐘舵€?*锛?8-10 鍏ㄤ粨鎶撳埌 5 澶勶紝鍚垜褰撳ぉ鑷繁鍐欑殑涓€澶勶級銆?    #    `swipes += 1` / `sig = 鏂版寚绾筦 / `done_rows = []` 鍐欏湪 `return swipe(...)`
    #    涔嬪墠 = mutate-before-ack + 鏁版剰鍥句笉鏁颁簨瀹烇細鍔ㄤ綔琚椄鍚炴帀銆佹垨 step 鍙槸
    #    鐪嬩簡涓€鐪煎喅绛栵紝璁℃暟鐓ф定銆侀槻绌鸿浆鐨勫熀鍑嗕篃琚薄鏌?鈬?鎻愬墠鍒ゃ€屾粦鍒板簳浜嗐€嶏紝
    #    momotalk 閭ｅ鏇翠細鎶婂凡鑱婅繃鐨勮鍙拌处娓呯 鈬?閲嶅鐐广€?    #    鈬?涓€寰嬫寕 `post=`锛坮unner/cli 鐨?swipe 鍒嗘敮閮戒細鍦ㄧ湡婊戝嚭鍘诲悗鎵ц瀹冿級銆?    bad = []
    for p in (root / "flow").glob("*.py"):
        lines = p.read_text(encoding="utf-8").splitlines()
        for i, line in enumerate(lines):
            if "return swipe(" not in line:
                continue
            # 鈿犲彧鐪?*鍚屼竴鏉℃墽琛岃矾寰?*涓婄殑璇彞锛氬悜涓婇亣鍒板埆鐨?`return` 灏卞仠
            #   锛堟棭閫€鍒嗘敮閲岀殑璧嬪€艰窡杩欎竴鍙?swipe 鏃犲叧锛岀畻瀹冨氨鏄鎶ワ級銆?            for j in range(i - 1, max(-1, i - 6), -1):
                s = lines[j].strip()
                if s.startswith("#"):
                    continue
                if s.startswith("return") or s.startswith("raise"):
                    break
                if re.search(r"self\.state\[[^\]]+\]\s*(\+=|=)(?!=)", s):
                    bad.append(f"{p.name}:{j+1} {s[:48]}")
    check("鉀斺洈婊戝姩鍓嶄笉璁告敼鐘舵€侊紙璁℃暟/鎸囩汗/鍙拌处涓€寰嬫寕 post锛?, not bad,
          " | ".join(bad))

    # 鉀斺洈**`浠诲姟寮€濮媊 鍙鍑虹幇鍦ㄧ湡鐨勮鎵撳叧鍗＄殑 flow 閲?*锛?8-10 宸竴姝ヨ姳 30 闈掕緣鐭筹級銆?    #    瀹為敜锛歚ArenaFlow.on_stage_popup` 鍐欑潃
    #      `find([TASK_START, SWEEP_START]) 鈫?tap("寮€濮?)`锛?    #    鑰屾垬鏈ぇ璧涘帇鏍规病鏈夊叧鍗″脊绐?鈬?event 鏀跺伐鍋滃湪娲诲姩鍏冲崱寮圭獥涓娿€乤rena 鎺ユ墜锛?    #    涓€涓婃潵灏辩偣浜嗐€屼换鍔″紑濮嬨€嶏紝褰撴椂 AP=9 鈬?娓告垙寮广€岃臣璨稟P 鍠児馃拵30銆嶏紝
    #    鍏ㄩ潬 money 闂?halt 鎵嶆病鎴愪氦銆俶omotalk / mining 閲屼篃娣风潃鍚屼竴涓敭锛堝凡娓咃級銆?    #    鈬?鐧藉悕鍗曪細鍙湁 sweep锛堟偓璧?JFD锛夊拰 event锛堟椿鍔級浼氱湡鐨勫紑鍏冲崱銆?    _STAGE_OK = {"sweep.py", "event.py"}
    bad2 = []
    for p in (root / "flow").glob("*.py"):
        if p.name in _STAGE_OK:
            continue
        for i, line in enumerate(p.read_text(encoding="utf-8").splitlines(), 1):
            s = line.strip()
            if s.startswith("#") or s.startswith('"'):
                continue
            if "V.TASK_START" in s:
                bad2.append(f"{p.name}:{i}")
    check("鉀斺洈鍙湁 sweep/event 鍙互寮曠敤 `浠诲姟寮€濮媊锛堝埆鐨?flow 鐐瑰畠 = 璇墦鎴樻枟鍚?AP锛?,
          not bad2, " | ".join(bad2))

    # 鉀斺洈flow 瀛愮被涓嶈瑕嗗啓 decide() 鈥斺€?2026-08-08 鎮祻 live 瀹為敜:
    #    TicketSweepFlow 鑷繁鍐欎簡鎸夐〉娲惧彂, 鎶婂熀绫?**overlay鈫掗〉闈?* 椤哄簭鏁翠釜
    #    璺宠繃 鈬?鎵崱纭妗嗗紑鐫€鏃剁収鏍疯窇鍒楄〃閫昏緫, 鎶婂璇濇閲岀殑璐圭敤琛岀エ鍥炬爣
    #    褰撶エ鏁伴敋璇诲嚭 0 鈫?浼姤"绁ㄧ敤瀹屼簡"銆?    overrides = []
    for p in (root / "flow").glob("*.py"):
        if p.name == "base.py":
            continue
        for i, line in enumerate(p.read_text(encoding="utf-8").splitlines(), 1):
            if re.match(r"\s*def decide\s*\(", line):
                overrides.append(f"flow/{p.name}:{i}")
    check("鉀斺洈flow 瀛愮被涓嶈瑕嗗啓 decide()锛坥verlay 椤哄簭浼氳璺宠繃锛?,
          not overrides, str(overrides))


