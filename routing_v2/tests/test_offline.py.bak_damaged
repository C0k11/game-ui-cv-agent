             *[B(V.STAGE_ENTER_LOCKED, cy=0.40 + i * 0.1) for i in range(4)])
    check("搂A9 鏂版椿鍔ㄩ鏃?1寮€4閿?浠嶆槸鍏冲崱鍒楄〃",
          classify(day1).page == "event_quest_list",
          f"瀹為檯 {classify(day1).page}")

    # 猸惵1 杞満甯э細鍙湁 鍥炲ぇ鍘?杩斿洖閿殑甯?*涓嶈**褰撳満瑙﹀彂"鐐瑰洖澶у巺"銆?    #    锛堝畠鐜板湪浼氳璁ゆ垚娉涘寲鐨?`facility`锛屼絾娉涘寲椤甸潰瑕佸緟澶?90 甯ф墠鍑嗚蛋浜?鈥斺€?    #      浠讳綍杞満閮芥椿涓嶈繃 90 甯э紝鎵€浠ョ敤鎴风幇鍦虹湅鍒扮殑"鍒氳杩涙垬鏂楀氨琚脊鍥炲ぇ鍘?
    #      涓嶄細澶嶇幇銆傝涓烘柇瑷€姣旈〉闈㈠悕鏂鏇存湁鎰忎箟銆傦級
    stray = O(B(V.HOME, cx=0.05, cy=0.05), B(V.BACK, cx=0.02, cy=0.05))
    from routing_v2.flow import nav as _nav
    from routing_v2.state.machine import Machine as _MM
    _m = _MM(3)
    for _ in range(3):
        _s = _m.update(stray)
