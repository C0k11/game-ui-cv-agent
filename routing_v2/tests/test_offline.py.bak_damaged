          classify(body).interrupt == "money_popup")
    check("椤舵爮闈掕緣鐭充笉璇姤", classify(top).interrupt is None,
          f"瀹為檯 {classify(top).interrupt}")

    # 鉀?026-08-08 live 瀹為敜锛氬ぇ鍘呭乏渚у父椹汇€岃喘涔伴潚杈夌煶銆嶅箍鍛婁綅 conf 0.95銆?    #    鎸夎瘝鍒や細璁瘡涓€杞殑绗竴甯у氨 HALT銆傚繀椤婚厤涓婂璇濇鎺т欢鎵嶇畻璐拱娴佺銆?    banner = O(B(V.SHOP_BUY_PYROXENE, conf=0.95, cx=0.117, cy=0.360),
